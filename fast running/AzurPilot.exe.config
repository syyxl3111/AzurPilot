<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- System.Windows.Forms.ApplicationConfigurationSection 由 .NET Framework 4.7+
       在 machine.config 中内置声明，此处绝不能再写 <configSections>，
       否则整个配置系统初始化失败（连 TcpClient 都会抛
       ConfigurationErrorsException）。直接使用该节即可。 -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
